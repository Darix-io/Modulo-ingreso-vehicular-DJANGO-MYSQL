# Copia este archivo como ".env" y cambia los valores.
# El archivo .env NO se sube a GitHub.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo en producción (HTTPS): direcciones completas separadas por comas, ej: https://usuario.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos (SQLite) ---
# Nombre del archivo donde se guardan los datos, dentro de la carpeta del proyecto
DB_NAME=db.sqlite3

# --- Sistema QR ---
# Dirección que se guarda dentro de cada QR. Si pruebas con el celular en la
# misma red WiFi, pon la IP de tu PC, ej: http://192.168.1.10:8000
VALIDACION_URL_BASE=http://localhost:8000

# --- Usuarios de prueba (comando seed_roles_users) ---
SEED_ADMIN_PASSWORD=Admin1234!
SEED_SEGURIDAD_PASSWORD=Seguridad123!
